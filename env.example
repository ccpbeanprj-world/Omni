# Omni Platform Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Encryption at rest (64 hex chars). Generate locally; never commit the value.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Security Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRES_IN=24h
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database Configuration
# SQLite (fallback)
SQLITE_PATH=./omni.db

# PostgreSQL (primary)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=omni
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_SSL=false

# LINE Platform Configuration
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_POLLING_INTERVAL=2000
LINE_WEBHOOK_URL=https://your-domain.com/webhook/line

# WhatsApp (Twilio) — used by the live Omni inbox
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_PHONE_NUMBER=+14155238886

# WhatsApp Cloud API (optional / alternate)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp
WHATSAPP_API_VERSION=v18.0

# Facebook Platform Configuration
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_facebook_page_id

# Telegram Platform Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# Real-time Configuration
REAL_USER_POLLING_INTERVAL=2000
FALLBACK_POLLING_INTERVAL=5000
HEALTH_CHECK_INTERVAL=30000

# Socket.IO Configuration
SOCKET_RECONNECTION_ATTEMPTS=5
SOCKET_RECONNECTION_DELAY=1000
SOCKET_TIMEOUT=20000

# AI Auto-Reply is not used for this product. Keep off. Do not set ANTHROPIC_API_KEY.
# AI_ENABLED=false
# AI_AUTO_REPLY_ENABLED=false

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=5
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_FORMAT=simple